# Forever Memories production-style local configuration
PORT=4242
NODE_ENV=development
APP_URL=http://localhost:4242
PUBLIC_FILE_BASE_URL=http://localhost:4242/uploads
CURRENCY=usd

# Stripe
# Leave blank for mock checkout. Add Stripe test secret key when ready.
STRIPE_SECRET_KEY=

# Lulu sandbox
# Keep sandbox values here while testing. Do not commit a real .env file.
LULU_BASIC_AUTH=
LULU_TOKEN_URL=https://api.sandbox.lulu.com/auth/realms/glasstree/protocol/openid-connect/token
LULU_BASE_URL=https://api.sandbox.lulu.com
LULU_CONTACT_EMAIL=
LULU_DEFAULT_SHIPPING_LEVEL=MAIL
LULU_DEFAULT_PAGE_COUNT=160

# 6 x 9 paperback and casewrap hardcover examples. Confirm final SKUs in Lulu calculator before launch.
LULU_PAPERBACK_POD_PACKAGE_ID=0600X0900.BW.STD.PB.060UW444.MXX
LULU_HARDCOVER_POD_PACKAGE_ID=0600X0900.BW.STD.CW.060UW444.MXX

# Prices
PAPERBACK_PRICE_CENTS=6900
HARDCOVER_PRICE_CENTS=8900

# Image upload and human-face validation
MAX_IMAGE_UPLOAD_MB=6
# Local default: local-preview accepts uploads for testing even when browser FaceDetector is unreliable.
# Production option: aws-rekognition. Requires AWS credentials in your environment.
FACE_DETECTION_PROVIDER=local-preview
MINIMUM_FACE_COUNT=1
MAXIMUM_FACE_COUNT=1
MINIMUM_FACE_CONFIDENCE=90
AWS_REGION=us-east-1


# Admin login
# Default local login is admin / admin. Change it in the admin panel before hosting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret-before-hosting

# AI cover art integration
# Local testing uses vector art. Later you can set AI_COVER_PROVIDER=openai, replicate, or stability
# and add the matching key. The current code prepares prompts and integration hooks.
AI_COVER_PROVIDER=mock
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=

# Cover production fallback values used when Lulu cover-dimensions API is unavailable locally.
COVER_BLEED_IN=0.125
HARDCOVER_WRAP_IN=0.75

# Story/resume upload
MAX_STORY_UPLOAD_MB=12

# Internal email notifications
# Gmail SMTP — use an App Password (not your normal password).
# Generate at: https://myaccount.google.com/apppasswords
# Multiple recipients: comma-separated list in ADMIN_NOTIFICATION_EMAIL
ADMIN_NOTIFICATION_EMAIL=noman@canvasdigital.net, arsalan.mustafa@canvasdigital.org, abdullah.saeed@canvasdigital.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=abdullah.saeed@canvasdigital.org
SMTP_PASS=rmyc wvex arrg sraj
SMTP_FROM=abdullah.saeed@canvasdigital.org
